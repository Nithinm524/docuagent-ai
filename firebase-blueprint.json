{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile and role metadata for authenticated users",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase User ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name or display name" },
        "role": { "type": "string", "enum": ["admin", "reviewer", "viewer", "applicant"], "description": "Assigned access role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last authenticated timestamp" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User account documents keyed by Firebase Authentication UID"
    }
  }
}
