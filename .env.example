# ==============================================================================
# DOCUAGENT AI - Environment Configuration Example
# Copy this file to .env and configure the values for your deployment environment.
# NEVER commit .env files containing real secret keys to source control.
# ==============================================================================

# Port to bind the server (AI Studio runs on 3000)
PORT=3000

# Node environment mode: 'development' or 'production'
NODE_ENV=production

# Server-Side Google Gemini API Key (OPTIONAL)
# When provided, enables multimodal vision OCR and generative executive summaries.
# When omitted, DOCUAGENT AI automatically falls back to deterministic local OCR extraction.
GEMINI_API_KEY="your-gemini-api-key-here"

# Verified public application URL for mobile QR code access and external link sharing
VITE_SHARED_APP_URL="https://docuagent-ai.ai.studio"

# Force HTTPS redirect behind reverse proxies (set to 'true' for production deployments)
FORCE_HTTPS="false"

# Operational & Compliance Contact Emails (OPTIONAL)
# When provided, activates functional mailto: links in Privacy, Terms, Cookie, and DPDP disclosures.
# When omitted, DOCUAGENT AI renders clear institutional deployment notes.
VITE_PRIVACY_EMAIL="privacy@your-domain.example"
VITE_LEGAL_EMAIL="legal@your-domain.example"
VITE_GRIEVANCE_EMAIL="grievance-officer@your-domain.example"

# ==============================================================================
# Razorpay Payment Gateway Configuration (OPTIONAL)
# When provided, activates live Razorpay checkout and webhook validation in INR.
# When omitted or empty, DOCUAGENT AI automatically engages its built-in local
# cryptographic test sandbox mode for seamless staging and offline evaluation.
# ==============================================================================
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"
VITE_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
